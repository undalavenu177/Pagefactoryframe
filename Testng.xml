<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Browser Suite"
       parallel="tests"
       thread-count="4">
<listeners>
    <listener class-name="Listeners.Itestlisten"/>
</listeners>
    <test name="Chrome">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="Testrunner.lgtests"/>
        </classes>

    </test>

   <test name="Chrome-2">

        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="Testrunner.lgtests"/>
        </classes>

    </test>

    <test name="Firefox">

        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="Testrunner.lgtests"/>
        </classes>
        
    </test>
       <test name="Edge">

        <parameter name="browser" value="edge"/>

        <classes>
            <class name="Testrunner.lgtests"/>
        </classes>
        
    </test>

</suite>